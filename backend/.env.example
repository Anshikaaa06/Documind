# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "groq" | "anthropic" | "openai"
LLM_PROVIDER=groq

# Groq (completely FREE — 14,400 req/day, no credit card needed)
# Sign up at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Anthropic Claude (paid, ~$3/M input tokens)
# Sign up at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (paid, ~$0.15/M input tokens for gpt-4o-mini)
# Sign up at: https://platform.openai.com
# OPENAI_API_KEY=sk-...

# ── Embedding Provider ────────────────────────────────────────────────────────
# Options: "local" | "openai"
# "local" uses sentence-transformers/all-MiniLM-L6-v2 (free, runs on CPU, 384-dim)
# "openai" uses text-embedding-3-small (paid, 1536-dim, better quality)
EMBEDDING_PROVIDER=local

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Frontend (CORS) ───────────────────────────────────────────────────────────
# Local development default — change to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173
